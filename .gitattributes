# 统一换行：CI 在 Linux 上跑，文本一律以 LF 入库，避免 gradlew 出现 bad interpreter
* text=auto eol=lf

# Unix 脚本必须是 LF
gradlew text eol=lf
*.sh    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# Windows 批处理必须是 CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 二进制，禁止任何转换
*.jar   binary
*.jks   binary
*.keystore binary
*.apk   binary
*.png   binary
*.webp  binary
